# testnet | mainnet
PUBLIC_STELLAR_NETWORK=testnet
PUBLIC_TIPJAR_CONTRACT_ID=
PUBLIC_XLM_SAC=
PUBLIC_USDC_SAC=
# Optional. Defaults to the public RPC for the network above.
PUBLIC_RPC_URL=
PUBLIC_SITE_URL=http://localhost:3000

# Server only. The account that pays fees for sponsored transactions.
# Keep only enough XLM on it for a few days of fees.
SPONSOR_SECRET=
# Largest Soroban resource fee the sponsor will cover for one transaction, in stroops.
SPONSOR_MAX_RESOURCE_FEE=2000000
# Sponsored transactions per source account per day.
SPONSOR_DAILY_LIMIT_PER_ACCOUNT=25
